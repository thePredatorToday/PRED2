# PREDATOR .env konfigurace
# Zkopíruj jako .env a vyplň hodnoty

# === Systém ===
SYSTEM_MODE=SHADOW
# SHADOW = simulace bez peněz
# PAPER  = simulace s virtuálním balancí
# BETA   = reálné obchody, limit 0.1 SOL
# LIVE   = plný provoz

# === Solana RPC ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_FALLBACK=https://rpc.helius.xyz/?api-key=YOUR_KEY

# === Wallet (povinné pro BETA/LIVE) ===
# WALLET_PRIVATE_KEY=tvuj_base58_privatni_klic

# === Telegram notifikace ===
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-100123456789

# === X (Twitter) OAuth 1.0a ===
# X_API_KEY=tvuj_api_key
# X_API_SECRET=tvuj_api_secret
# X_ACCESS_TOKEN=tvuj_access_token
# X_ACCESS_TOKEN_SECRET=tvuj_access_token_secret

# === Limity ===
# MAX_POSITION_SIZE=2.0
# MAX_OPEN_POSITIONS=3
# DAILY_DRAWDOWN_PCT=-30
# SOLANA_RESERVE=0.005
# VIRTUAL_BALANCE_SOL=10.0

# === Logging ===
# LOG_LEVEL=INFO
